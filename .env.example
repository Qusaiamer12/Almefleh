# ===== إعدادات نظام مستودعات المفلح =====
NODE_ENV=production
PORT=3000

# ---------- قاعدة البيانات ----------
# Supabase → Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
DATABASE_SSL=true
DB_POOL_MAX=8

# ---------- الأمان (لازم تتغيّر! توليد: openssl rand -hex 32) ----------
JWT_SECRET=
CRED_KEY=
SESSION_HOURS=12

# ---------- التوقيت والعملة ----------
APP_TIMEZONE=Asia/Amman
CURRENCY=د.أ

# ---------- كلمات السر الأوّلية وقت التهيئة ----------
# (٨ خانات على الأقل، فيها حرف ورقم - بتتغيّر من داخل النظام بعدين)
SEED_ADMIN_PASSWORD=
SEED_DEFAULT_PASSWORD=

# ---------- الترحيل ----------
# false = الخدمة بترفض تشتغل إذا في ترحيل معلّق (الأأمن للإنتاج)
# true  = بتطبّق الترحيلات لحالها وقت الإقلاع
AUTO_MIGRATE=false

# ---------- النسخ الاحتياطي ----------
BACKUP_ENABLED=true
BACKUP_CRON=0 * * * *
BACKUP_DIR=backups
BACKUP_KEEP_LOCAL=24
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=

# ---------- السجلّات والمراقبة ----------
LOG_LEVEL=info
SLOW_QUERY_MS=500
SLOW_REQUEST_MS=1500

# ---------- حدود الطلبات ----------
RATE_MAX=300
RATE_WINDOW_MS=60000

# ---------- التنظيف الدوري ----------
LOGIN_ATTEMPT_RETENTION_DAYS=30
NOTIFICATION_RETENTION_DAYS=120
