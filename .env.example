# ===== إعدادات نظام مستودعات المفلح =====
NODE_ENV=production
PORT=3000

# قاعدة البيانات (Supabase → Project Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
DATABASE_SSL=true

# مفاتيح الأمان - لازم تتغيّر! (توليد: openssl rand -hex 32)
JWT_SECRET=
CRED_KEY=
SESSION_HOURS=12

# التوقيت والعملة
APP_TIMEZONE=Asia/Amman
CURRENCY=د.أ

# كلمات السر الأوّلية وقت التهيئة (بتتغيّر من داخل النظام بعدين)
SEED_ADMIN_PASSWORD=
SEED_DEFAULT_PASSWORD=

# النسخ الاحتياطي (كل ساعة) ورفعه على جوجل درايف
BACKUP_ENABLED=true
BACKUP_CRON=0 * * * *
BACKUP_DIR=backups
BACKUP_KEEP_LOCAL=24
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=
